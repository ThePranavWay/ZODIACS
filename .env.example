# Store actual values privately in Vercel Production environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SIGNING_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ORGANIZER_PASSWORD=REPLACE_WITH_A_DIFFERENT_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# ALLOW_LEGACY_RECOVERY is no longer used. Old browser credentials cannot authenticate v2.
# Level password hashes (SHA-256 hex of each level code). Set LEVEL_1 for /letter,
# and add one per level as Levels 2-7 go live. Never commit plaintext level codes.
# LEVEL_1_PASSWORD_SHA256=
# LEVEL_2_PASSWORD_SHA256=
# LEVEL_3_PASSWORD_SHA256=
# LEVEL_4_PASSWORD_SHA256=
# LEVEL_5_PASSWORD_SHA256=
# LEVEL_6_PASSWORD_SHA256=
# LEVEL_7_PASSWORD_SHA256=
# Leave unset (Lax) for the normal public top-level site (e.g. Vercel). Set to None
# ONLY for trusted cross-site iframe embedding (e.g. a hosted preview frame): it uses
# Secure+Partitioned cookies and an Authorization-token fallback so registration/login
# enter directly and are not bounced when the browser blocks third-party cookies.
# SESSION_COOKIE_SAMESITE=None
